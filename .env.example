# Database Configuration (REQUIRED)
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/database_name

# Authentication (REQUIRED)
# Must be at least 32 characters
SECRET_KEY=your_jwt_secret_key_here_min_32_characters

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Origins (comma-separated URLs)
# Example: http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000

# AI/LLM API Configuration (Optional)
# For post recommendations using Claude API
AI_GATEWAY_API_KEY=your_ai_api_key_here
